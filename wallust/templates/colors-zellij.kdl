// ---- Design Tokens v0.1 ----
// Semantic color contract for Zellij
// Regenerated by wallust on wallpaper change

themes {
    hypr-tokens {
        colors {
            main_frame {
                background "{{background}}"
                border "{{color10}}"
            }

            pane {
                frame {
                    border "{{color10}}"
                }
                focused_frame {
                    border "{{color12}}"
                }
                focused {
                    border "{{color12}}"
                }
            }

            tab_bar {
                background "{{color0}}"
                control {
                    foreground "{{color8}}"
                    background "{{color0}}"
                }
                tab {
                    foreground "{{color8}}"
                    background "{{color0}}"
                }
                active_tab {
                    foreground "{{background}}"
                    background "{{color12}}"
                }
                active_tab_fullscreen {
                    foreground "{{background}}"
                    background "{{color12}}"
                }
                active_sync {
                    foreground "{{background}}"
                    background "{{color12}}"
                }
            }

            status_bar {
                background "{{color0}}"
            }
        }
    }
}

theme "hypr-tokens"
